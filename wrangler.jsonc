{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mapping-log",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // หน้าเว็บ (React) เป็นไฟล์ static ส่วน /api/* ให้ Worker จัดการ
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mapping-log",
      // database_id ของ D1 (ดูได้ที่หน้า D1 ใน Cloudflare) — ไม่ใช่ความลับ
      "database_id": "bd0593ff-8bf6-45d8-8e35-096028fa785e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "upload_source_maps": true
}
